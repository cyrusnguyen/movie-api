# Required. Any random string of 32+ characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Port to listen on. Defaults to 3000.
PORT=3000

# Optional. Leave blank to use the bundled SQLite database at data/movies.db,
# which needs no setup. Set it to use MySQL instead, e.g.
#   DATABASE_URL=mysql://user:password@host:3306/movies
DATABASE_URL=

# Comma-separated list of browser origins allowed to call this API.
# Defaults to the local Vite dev server.
CORS_ORIGIN=http://localhost:5173

# bcrypt work factor. Higher is slower and safer. Defaults to 10.
BCRYPT_ROUNDS=10
