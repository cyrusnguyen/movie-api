{
  "name": "movie-api",
  "version": "2.0.0",
  "private": true,
  "description": "REST API for movie search, credits and ratings, with JWT auth and OpenAPI docs.",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node ./bin/www",
    "dev": "node --watch ./bin/www",
    "migrate": "knex migrate:latest",
    "rollback": "knex migrate:rollback",
    "seed": "node ./scripts/seed.js",
    "reset": "node ./scripts/seed.js --force",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^11.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "http-errors": "^2.0.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "morgan": "^1.10.0",
    "mysql2": "^3.11.4",
    "swagger-ui-express": "^5.0.1"
  }
}
