#!/usr/bin/env node
'use strict';

/**
 * HTTP server entry point.
 */

const http = require('http');

const app = require('../app');
const knexConfig = require('../knexfile');

const port = normalizePort(process.env.PORT || '3000');
app.set('port', port);

// The previous version attached these listeners to the Express app rather than
// the http.Server, so neither ever fired and startup failures were silent.
const server = http.createServer(app);

start();

async function start() {
  try {
    await prepareDatabase();
  } catch (err) {
    console.error('Database preparation failed:', err.message);
    process.exit(1);
  }

  server.listen(port);
  server.on('error', onError);
  server.on('listening', onListening);
}

/**
 * Bring the schema up to date, and load the bundled catalogue the first time
 * the app runs so a fresh clone needs no extra setup step.
 */
async function prepareDatabase() {
  const knex = app.knex;

  await knex.migrate.latest();

  const [{ count }] = await knex('basics').count({ count: '*' });

  if (Number(count) === 0) {
    console.log('Empty catalogue detected — loading bundled sample data…');
    const { seed } = require('../scripts/seed');
    await seed({ quiet: true });
  }
}

function normalizePort(val) {
  const parsed = parseInt(val, 10);

  if (Number.isNaN(parsed)) return val; // named pipe
  if (parsed >= 0) return parsed;

  return false;
}

function onError(error) {
  if (error.syscall !== 'listen') throw error;

  const bind = typeof port === 'string' ? `Pipe ${port}` : `Port ${port}`;

  switch (error.code) {
    case 'EACCES':
      console.error(`${bind} requires elevated privileges`);
      process.exit(1);
      break;
    case 'EADDRINUSE':
      console.error(`${bind} is already in use`);
      process.exit(1);
      break;
    default:
      throw error;
  }
}

function onListening() {
  const addr = server.address();
  const bind = typeof addr === 'string' ? `pipe ${addr}` : `port ${addr.port}`;
  const engine = knexConfig.isSqlite ? 'SQLite (bundled)' : 'MySQL';

  console.log(`Movie API listening on ${bind}  •  database: ${engine}`);
  console.log(`API reference: http://localhost:${addr.port}/`);
}

const shutdown = async (signal) => {
  console.log(`\n${signal} received, shutting down…`);
  server.close();
  await app.knex.destroy();
  process.exit(0);
};

process.on('SIGINT', () => shutdown('SIGINT'));
process.on('SIGTERM', () => shutdown('SIGTERM'));
